{
  "name": "RealEstate Theme",
  "dataColors": [
    "#B8472F",
    "#2B2D42",
    "#F2B134",
    "#3A7D6B",
    "#8D99AE",
    "#6C91BF",
    "#8E7DBE",
    "#C9ADA7"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2D3A",
  "tableAccent": "#B8472F",
  "good": "#3A7D6B",
  "neutral": "#F2B134",
  "bad": "#B23A48",
  "maximum": "#B8472F",
  "center": "#F2B134",
  "minimum": "#B23A48",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#B8472F"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2D3A"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2D3A"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5F6B73"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1F2D3A"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE5E7"
              }
            },
            "radius": 10
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5F6B73"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5F6B73"
              }
            },
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E8EEF0"
              }
            }
          }
        ],
        "legend": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5F6B73"
              }
            },
            "position": "Top"
          }
        ]
      }
    }
  }
}
