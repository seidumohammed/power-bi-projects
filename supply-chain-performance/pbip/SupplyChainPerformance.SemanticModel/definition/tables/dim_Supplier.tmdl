table dim_Supplier
	lineageTag: 1e882f50-45ad-4804-9a2c-f68787fef2eb

	column SupplierID
		dataType: string
		isHidden
		lineageTag: 658be85a-9744-42e2-a478-8dd75d84ed5e
		summarizeBy: none
		sourceColumn: SupplierID

	column Supplier
		dataType: string
		lineageTag: 197506e5-7a1e-4882-a0b4-7e4623f4a55f
		summarizeBy: none
		sourceColumn: Supplier

	column Origin
		dataType: string
		lineageTag: b244f723-c76f-40f0-824b-507d652e739e
		summarizeBy: none
		sourceColumn: Origin

	partition dim_Supplier = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "suppliers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Promoted, {{"supplier_id", "SupplierID"}, {"supplier", "Supplier"}, {"origin", "Origin"}}),
				    Selected = Table.SelectColumns(Renamed, {"SupplierID", "Supplier", "Origin"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"SupplierID", type text}, {"Supplier", type text}, {"Origin", type text}}, "en-US")
				in
				    Typed

