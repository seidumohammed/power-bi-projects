table dim_Product
	lineageTag: b3ae4510-0a92-44d3-86ae-f685e2e060c7

	column ProductID
		dataType: string
		isHidden
		lineageTag: ab92a71d-e157-442e-933d-452a93d3418c
		summarizeBy: none
		sourceColumn: ProductID

	column Product
		dataType: string
		lineageTag: 92f21a1b-80d5-4a3d-be0e-c8bc785e80a1
		summarizeBy: none
		sourceColumn: Product

	column Category
		dataType: string
		lineageTag: f7ed3a9d-a57d-4fe0-9e05-9aa182d9c49e
		summarizeBy: none
		sourceColumn: Category

	column SupplierID
		dataType: string
		isHidden
		lineageTag: 2f14abcc-fff2-43b0-ac8b-e1f2520f0272
		summarizeBy: none
		sourceColumn: SupplierID

	column UnitCostGHS
		dataType: double
		isHidden
		lineageTag: 762a881c-015b-4799-8d0f-8a49490d5b0f
