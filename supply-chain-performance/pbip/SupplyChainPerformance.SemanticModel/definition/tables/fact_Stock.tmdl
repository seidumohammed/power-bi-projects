table fact_Stock
	lineageTag: 39037f0a-7cfa-42aa-9d76-6bd9c3ef260d

	column SnapshotDate
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: b9e7f715-a2b8-40c1-9f63-ff8f3e24d09f
		summarizeBy: none
		sourceColumn: SnapshotDate

		annotation UnderlyingDateTimeDataType = Date

	column WarehouseID
		dataType: string
		isHidden
		lineageTag: 48df924a-9ad2-458d-bf73-6f70fb38dac3
		summarizeBy: none
		sourceColumn: WarehouseID

	column ProductID
		dataType: string
		isHidden
		lineageTag: c850b354-2503-4ed4-b0e5-ead1f6c49157
		summarizeBy: none
		sourceColumn: ProductID

	column OnHandQty
		dataType: int64
		isHidden
		lineageTag: 1ff0ca93-8fb6-4050-9b9f-e6e49a66c4d4
		summarizeBy: none
		sourceColumn: OnHandQty

	column DemandQty
		dataType: int64
		isHidden
		lineageTag: 772f1c06-4f0d-4d11-b171-50156b386777
		summarizeBy: none
		sourceColumn: DemandQty

	column IsStockout
		dataType: int64
		isHidden
		lineageTag: e5d9f889-4b2c-4466-823d-1473fcd5df66
		summarizeBy: none
		sourceColumn: IsStockout

	partition fact_Stock = m
		mode: import
		source =
				// Month-end stock count per hub and product.
				let
				    Source = Csv.Document(File.Contents(DataFolder & "stock.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Promoted, {{"snapshot_date", "SnapshotDate"}, {"warehouse_id", "WarehouseID"}, {"product_id", "ProductID"}, {"on_hand_qty", "OnHandQty"}, {"demand_qty", "DemandQty"}}),
				    Selected = Table.SelectColumns(Renamed, {"SnapshotDate", "WarehouseID", "ProductID", "OnHandQty", "DemandQty"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"SnapshotDate", type date}, {"WarehouseID", type text}, {"ProductID", type text}, {"OnHandQty", Int64.Type}, {"DemandQty", Int64.Type}}, "en-US"),
				    AddIsStockout = Table.AddColumn(Typed, "IsStockout", each if [OnHandQty] <= 0 then 1 else 0, Int64.Type)
				in
				    AddIsStockout

	annotation PBI_ResultType = Table

