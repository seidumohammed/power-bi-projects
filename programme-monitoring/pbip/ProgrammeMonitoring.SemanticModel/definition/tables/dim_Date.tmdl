	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: 2668904f-be3f-4459-9dbf-6aa724dbcc37
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		lineageTag: b0bcb9bb-a2de-4d33-b4c6-e6575293d334
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: 900f67f5-98c7-4476-9a2d-22475a89572d
		summarizeBy: none
		sourceColumn: Quarter

