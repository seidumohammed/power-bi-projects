		dataType: int64
		isHidden
		lineageTag: 6af534b9-f294-4caf-9007-b749d3433f1b
		summarizeBy: none
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		lineageTag: c1072480-91b7-4ad4-81c2-eab43ea13719
		summarizeBy: none
		sourceColumn: MonthName
