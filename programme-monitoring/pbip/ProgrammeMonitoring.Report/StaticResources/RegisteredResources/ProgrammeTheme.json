{
  "name": "Programme Theme",
  "dataColors": [
    "#1B998B",
    "#F2A541",
    "#0B3C49",
    "#E4572E",
    "#6C8EAD",
    "#9BC53D",
    "#7E5A9B",
    "#C9CBA3"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2D3A",
  "tableAccent": "#0F6E6E",
  "good": "#1B998B",
  "neutral": "#F2A541",
  "bad": "#E4572E",
  "maximum": "#0F6E6E",
  "center": "#F2A541",
  "minimum": "#E4572E",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F6E6E"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2D3A"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2D3A"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5F6B73"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1F2D3A"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE5E7"
              }
            },
            "radius": 10
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5F6B73"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5F6B73"
              }
            },
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E8EEF0"
              }
            }
          }
        ],
        "legend": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5F6B73"
              }
            },
            "position": "Top"
          }
        ]
      }
    }
  }
}