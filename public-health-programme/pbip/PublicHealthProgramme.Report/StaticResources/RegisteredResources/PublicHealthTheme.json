{
  "name": "PublicHealth Theme",
  "dataColors": [
    "#4C8C2B",
    "#E2A72E",
    "#C8553D",
    "#2F4B26",
    "#6BA3BE",
    "#9C7BB5",
    "#8AA66F",
    "#A6A6A6"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2D1A",
  "tableAccent": "#4C8C2B",
  "good": "#4C8C2B",
  "neutral": "#E2A72E",
  "bad": "#C8553D",
  "maximum": "#4C8C2B",
  "center": "#E2A72E",
  "minimum": "#C8553D",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#4C8C2B"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2D1A"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2D1A"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5E6B58"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1F2D1A"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE5D3"
              }
            },
            "radius": 6
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5E6B58"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5E6B58"
              }
            },
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E7EEE0"
              }
            }
          }
        ],
        "legend": [
          {
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#5E6B58"
              }
            },
            "position": "Top"
          }
        ]
      }
    }
  }
}
