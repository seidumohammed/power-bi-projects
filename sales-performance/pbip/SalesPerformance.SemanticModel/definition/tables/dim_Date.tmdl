table dim_Date
	lineageTag: 8795fcd0-3731-4f44-9547-bc3cd053d6d2
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: a561a3bd-8a80-406b-8459-bb0ca7e8a2ce
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		lineageTag: 8cd130d8-3de3-4b7a-9c2e-e9c19df46b9a
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: ffb8fcea-1415-476a-8998-63ae05941d51
		summarizeBy: none
		sourceColumn: Quarter

