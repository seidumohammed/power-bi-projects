		dataType: int64
		isHidden
		lineageTag: 508a5f17-68a5-42bc-9708-734c858a3dee
		summarizeBy: none
		sourceColumn: MonthNumber

	column MonthName
		dataType: string
		lineageTag: 33e066a9-e6dc-40b3-8fee-a59a159a3508
		summarizeBy: none
		sourceColumn: MonthName
