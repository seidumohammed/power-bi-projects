table dim_Customer
	lineageTag: 1a45cd66-a6c1-4b93-af56-ed1cf3ada694

	column CustomerID
		dataType: string
		isHidden
		lineageTag: 1838480f-f311-4218-a480-8bb36b74ae0f
		summarizeBy: none
		sourceColumn: CustomerID

	column Segment
		dataType: string
		lineageTag: 49b2683a-1e66-4003-8f48-03230defe64c
		summarizeBy: none
		sourceColumn: Segment

	column HomeStoreID
		dataType: string
		isHidden
		lineageTag: 4be66b56-01bc-4026-85ea-d7e986b14214
		summarizeBy: none
		sourceColumn: HomeStoreID

	column JoinedDate
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: d79cea73-77cf-411a-9470-99ce0392b50d
		summarizeBy: none
		sourceColumn: JoinedDate

		variation Variation
			isDefault
			relationship: 5c3f47df-78ae-43b8-bb7a-83dbd32d4f45
			defaultHierarchy: LocalDateTable_e7b2d344-73d2-48ff-ad29-8ed8d6431142.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	partition dim_Customer = m
		mode: import
		source =
				// Cleaning: segment arrives in mixed case with stray spaces ("  retail ", "WHOLESALE").
				let
				    Source = Csv.Document(File.Contents(DataFolder & "customers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Promoted, {{"customer_id", "CustomerID"}, {"segment", "Segment"}, {"home_store", "HomeStoreID"}, {"joined", "JoinedDate"}}),
				    CleanSegment = Table.TransformColumns(Renamed, {{"Segment", each Text.Proper(Text.Trim(_)), type text}}),
				    Typed = Table.TransformColumnTypes(CleanSegment, {{"CustomerID", type text}, {"HomeStoreID", type text}, {"JoinedDate", type date}}, "en-GB")
				in
				    Typed

	annotation PBI_ResultType = Table

